# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Production: MongoDB Atlas mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/ai-interview-prep-kit

# Frontend Configuration (Points to Express Backend URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Authentication (Generate a secure random string in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# LLM Configuration (OpenAI API Key required for live kit generation & evaluation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# MOCK_LLM=false

